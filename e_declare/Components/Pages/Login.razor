@page "/"
@page "/login"
@using e_declare.Data
@using e_declare.Models
@using Microsoft.EntityFrameworkCore
@using System.Security.Cryptography
@using System.Text
@inject AppDbContext Db
@inject NavigationManager Nav
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Iniciar Sesión — e-Declare</PageTitle>

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@300;400;500;600&display=swap');

    :root {
        --purple-deep:   #2c1a4d;
        --purple-dark:   #412870;
        --purple-mid:    #5b399c;
        --purple-accent: #784ccf;
        --purple-bright: #9e75ff;
        --purple-glow:   #d0bfff;
        --gold:          #d4b981;
        --gold-light:    #f0dcae;
        --white:         #ffffff;
        --white-dim:     rgba(255,255,255,0.9);
        --white-faint:   rgba(255,255,255,0.2);
        --border:        rgba(255,255,255,0.3);
        --border-focus:  rgba(255,255,255,0.8);
        --error:         #ff5e5e;
        --success:       #5ce0d5;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    ::-webkit-scrollbar { width: 10px; }
    ::-webkit-scrollbar-track { background: rgba(0,0,0,0.1); border-radius: 5px; }
    ::-webkit-scrollbar-thumb { background: var(--purple-glow); border-radius: 5px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--purple-bright); }

    .login-root {
        height: 100vh;
        background: var(--purple-deep);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'DM Sans', sans-serif;
        overflow: hidden;
        position: relative;
        padding: 20px 16px;
    }

    /* ── Background ── */
    .bg-canvas {
        position: fixed; inset: 0;
        pointer-events: none; z-index: 0; overflow: hidden;
    }

    .doc-float {
        position: absolute;
        width: 60px; height: 76px;
        border: 1.5px solid rgba(255,255,255,0.2);
        border-radius: 4px;
        background: rgba(255,255,255,0.1);
        animation: floatDoc linear infinite;
    }
    .doc-float::before {
        content: ''; position: absolute;
        top: 12px; left: 10px; right: 10px; height: 2px;
        background: rgba(255,255,255,0.3);
        box-shadow: 0 6px 0 rgba(255,255,255,0.25), 0 12px 0 rgba(255,255,255,0.2), 0 18px 0 rgba(255,255,255,0.15);
    }
    .doc-float::after {
        content: '\f00c'; font-family: 'FontAwesome';
        position: absolute; bottom: 8px; right: 8px;
        font-size: 10px; color: rgba(255,255,255,0.4);
    }
    .doc-float:nth-child(1) { left:5%;  animation-duration:18s; animation-delay:0s;   width:50px; height:64px; }
    .doc-float:nth-child(2) { left:15%; animation-duration:24s; animation-delay:-6s;  }
    .doc-float:nth-child(3) { left:28%; animation-duration:20s; animation-delay:-12s; width:44px; height:56px; }
    .doc-float:nth-child(4) { left:45%; animation-duration:22s; animation-delay:-4s;  }
    .doc-float:nth-child(5) { left:60%; animation-duration:17s; animation-delay:-9s;  width:52px; height:66px; }
    .doc-float:nth-child(6) { left:72%; animation-duration:25s; animation-delay:-2s;  }
    .doc-float:nth-child(7) { left:85%; animation-duration:19s; animation-delay:-15s; width:46px; height:58px; }
    .doc-float:nth-child(8) { left:92%; animation-duration:23s; animation-delay:-8s;  }

    @@keyframes floatDoc {
        0%   { transform: translateY(110vh) rotate(-8deg); opacity: 0; }
        5%   { opacity: 1; }
        95%  { opacity: 1; }
        100% { transform: translateY(-15vh) rotate(8deg); opacity: 0; }
    }

    .bg-glow {
        position: fixed; width: 700px; height: 700px; border-radius: 50%;
        background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
        top: 50%; left: 50%; transform: translate(-50%, -50%);
        animation: pulseGlow 6s ease-in-out infinite;
    }
    @@keyframes pulseGlow {
        0%, 100% { scale: 1; opacity: 0.8; }
        50%       { scale: 1.1; opacity: 1; }
    }

    .bg-stamp {
        position: fixed; width: 260px; height: 260px;
        border: 3px solid rgba(255,255,255,0.06); border-radius: 50%;
        top: 50%; right: 8%; transform: translateY(-50%) rotate(-15deg);
        display: flex; align-items: center; justify-content: center;
        font-family: 'Playfair Display', serif; font-size: 11px;
        letter-spacing: 6px; color: rgba(255,255,255,0.08);
        text-transform: uppercase; animation: rotateSlow 40s linear infinite;
    }
    @@keyframes rotateSlow { to { transform: translateY(-50%) rotate(345deg); } }

    /* ── Card ── */
    .login-card {
        position: relative; z-index: 10;
        width: 100%; max-width: 440px;
        background: linear-gradient(145deg, rgba(65,40,112,0.95) 0%, rgba(44,26,77,0.98) 100%);
        border: 1px solid var(--border);
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.4);
        overflow: hidden;
        animation: cardIn 0.7s cubic-bezier(0.22,1,0.36,1) both;
    }
    @@keyframes cardIn {
        from { opacity: 0; transform: translateY(36px) scale(0.97); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
    }
    .login-card::before {
        content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
        background: linear-gradient(90deg, transparent, var(--gold), var(--purple-bright), var(--gold), transparent);
    }

    /* ── Header ── */
    .login-header {
        padding: 32px 40px 24px;
        border-bottom: 1px solid var(--border);
        display: flex; align-items: center; gap: 18px;
    }
    .login-logo {
        width: 54px; height: 54px; border-radius: 14px;
        background: linear-gradient(135deg, var(--white-faint), rgba(255,255,255,0.35));
        display: flex; align-items: center; justify-content: center;
        font-size: 22px; color: var(--white);
        box-shadow: 0 4px 16px rgba(0,0,0,0.2);
        flex-shrink: 0;
    }
    .login-title h1 {
        font-family: 'Playfair Display', serif;
        font-size: 1.55rem; color: var(--white); line-height: 1.15;
    }
    .login-title p { font-size: 0.82rem; color: var(--white-dim); margin-top: 3px; }

    /* ── Avatar display ── */
    .avatar-display {
        display: flex; flex-direction: column; align-items: center;
        padding: 26px 40px 0;
        animation: fadeUp 0.5s ease 0.15s both;
    }
    @@keyframes fadeUp { from{opacity:0;transform:translateY(14px)} to{opacity:1;transform:translateY(0)} }

    .avatar-ring {
        width: 82px; height: 82px; border-radius: 50%;
        border: 3px solid var(--gold);
        box-shadow: 0 0 0 5px rgba(212,185,129,0.15), 0 8px 24px rgba(0,0,0,0.3);
        overflow: hidden;
        background: rgba(255,255,255,0.15);
        display: flex; align-items: center; justify-content: center;
        transition: all 0.4s ease;
        margin-bottom: 10px;
    }
    .avatar-ring img { width: 100%; height: 100%; object-fit: cover; }
    .avatar-ring .avatar-placeholder {
        font-size: 32px; color: rgba(255,255,255,0.4);
    }
    .avatar-ring.found {
        border-color: var(--success);
        box-shadow: 0 0 0 5px rgba(92,224,213,0.2), 0 8px 24px rgba(0,0,0,0.3);
    }
    .avatar-name {
        font-size: 0.9rem; font-weight: 600; color: var(--white);
        min-height: 1.2em; transition: opacity 0.3s;
    }
    .avatar-name.hidden { opacity: 0; }

    /* ── Body ── */
    .login-body { padding: 22px 40px 36px; }

    .form-field {
        display: flex; flex-direction: column; gap: 5px;
        margin-bottom: 16px;
        animation: fadeUp 0.4s ease both;
    }
    .form-field:nth-child(1) { animation-delay: 0.1s; }
    .form-field:nth-child(2) { animation-delay: 0.18s; }
    .form-field:nth-child(3) { animation-delay: 0.26s; }

    .form-field label {
        font-size: 0.72rem; font-weight: 600;
        text-transform: uppercase; letter-spacing: 0.8px;
        color: var(--white-dim);
    }
    .form-field label .req { color: var(--gold); }

    .form-field input {
        background: rgba(0,0,0,0.15);
        border: 1px solid var(--border);
        border-radius: 9px;
        padding: 11px 14px;
        color: var(--white);
        font-family: 'DM Sans', sans-serif;
        font-size: 0.9rem;
        outline: none;
        transition: all 0.22s;
        width: 100%;
    }
    .form-field input::placeholder { color: rgba(255,255,255,0.35); }
    .form-field input:focus {
        border-color: var(--border-focus);
        background: rgba(0,0,0,0.25);
        box-shadow: 0 0 0 3px rgba(255,255,255,0.07);
    }
    .form-field input.err {
        border-color: var(--error);
        background: rgba(255,94,94,0.08);
    }

    .pwd-wrapper { position: relative; display: flex; align-items: center; }
    .pwd-wrapper input { padding-right: 44px; }
    .pwd-toggle {
        position: absolute; right: 13px;
        color: rgba(255,255,255,0.45); cursor: pointer;
        font-size: 1rem; transition: color 0.2s;
    }
    .pwd-toggle:hover { color: var(--white); }

    .field-error {
        font-size: 0.73rem; color: #ffadad;
        font-weight: 600; display: flex; align-items: center; gap: 5px;
    }

    /* Forgot password */
    .forgot-row {
        display: flex; justify-content: flex-end;
        margin-top: -8px; margin-bottom: 22px;
    }
    .forgot-link {
        font-size: 0.78rem; color: var(--purple-glow);
        text-decoration: none; font-weight: 500;
        transition: color 0.2s;
    }
    .forgot-link:hover { color: var(--gold); text-decoration: underline; }

    /* Attempts warning */
    .attempts-bar {
        display: flex; align-items: center; gap: 8px;
        padding: 9px 13px;
        background: rgba(255,94,94,0.1);
        border: 1px solid rgba(255,94,94,0.3);
        border-radius: 8px;
        margin-bottom: 16px;
        font-size: 0.78rem;
        color: #ffadad;
        animation: fadeUp 0.3s ease;
    }

    /* Submit */
    .btn-submit {
        width: 100%; padding: 14px;
        border: none; border-radius: 10px;
        background: var(--white);
        color: var(--purple-deep);
        font-weight: 700; font-size: 1rem;
        font-family: 'DM Sans', sans-serif;
        cursor: pointer; transition: 0.2s;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        display: flex; align-items: center; justify-content: center; gap: 10px;
    }
    .btn-submit:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.3);
        background: var(--gold-light);
    }
    .btn-submit:disabled { opacity: 0.65; cursor: not-allowed; transform: none; }

    .login-footer {
        text-align: center; margin-top: 20px;
        font-size: 0.84rem; color: var(--white-dim);
    }
    .login-footer a { color: var(--gold); text-decoration: none; font-weight: 700; }
    .login-footer a:hover { text-decoration: underline; }

    /* Divider */
    .divider {
        display: flex; align-items: center; gap: 12px;
        margin: 20px 0;
        font-size: 0.72rem; color: rgba(255,255,255,0.35);
        letter-spacing: 1px; text-transform: uppercase;
    }
    .divider::before, .divider::after {
        content: ''; flex: 1; height: 1px;
        background: rgba(255,255,255,0.15);
    }

    @@media(max-width:480px){
        .login-header { padding: 24px 24px 18px; }
        .login-body   { padding: 18px 24px 28px; }
        .avatar-display { padding: 20px 24px 0; }
    }
</style>

<div class="login-root">
    <!-- Background -->
    <div class="bg-canvas">
        @for (int i = 0; i < 8; i++) { <div class="doc-float"></div> }
        <div class="bg-glow"></div>
        <div class="bg-stamp">e-declare · declaración electrónica</div>
    </div>

    <div class="login-card">

        <!-- Header -->
        <div class="login-header">
            <div class="login-logo">
                <i class="fa-solid fa-file-shield"></i>
            </div>
            <div class="login-title">
                <h1>Bienvenido</h1>
                <p>Ingresa a e-Declare · Sistema de Declaraciones</p>
            </div>
        </div>

        <!-- Avatar preview dinámico -->
        <div class="avatar-display">
            <div class="avatar-ring @(usuarioEncontrado != null ? "found" : "")">
                @if (usuarioEncontrado?.AvatarUrl != null)
                {
                    <img src="/images/Avatars/@usuarioEncontrado.AvatarUrl" alt="avatar"
                         onerror="this.style.display='none'" />
                }
                else
                {
                    <span class="avatar-placeholder">
                        <i class="fa-solid fa-user"></i>
                    </span>
                }
            </div>
            <div class="avatar-name @(usuarioEncontrado == null ? "hidden" : "")">
                @(usuarioEncontrado != null
                    ? $"{usuarioEncontrado.Nombres?.Split(' ').FirstOrDefault()} {usuarioEncontrado.Apellidos?.Split(' ').FirstOrDefault()}"
                    : "·")
            </div>
        </div>

        <!-- Form -->
        <div class="login-body">

            @if (intentosFallidos >= 2 && intentosFallidos < 3)
            {
                <div class="attempts-bar">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    Atención: @intentosFallidos intentos fallidos. Tu cuenta se bloqueará al llegar a 5.
                </div>
            }

            <!-- Email -->
            <div class="form-field">
                <label>Correo Electrónico <span class="req">*</span></label>
                <input type="email"
                       value="@email"
                       @oninput="OnEmailInput"
                       placeholder="correo@empresa.com"
                       class="@(errores.ContainsKey("Email") ? "err" : "")" />
                @if (errores.ContainsKey("Email"))
                {
                    <span class="field-error">
                        <i class="fa-solid fa-circle-exclamation"></i> @errores["Email"]
                    </span>
                }
            </div>

            <!-- Password -->
            <div class="form-field">
                <label>Contraseña <span class="req">*</span></label>
                <div class="pwd-wrapper">
                    <input type="@(mostrarPassword ? "text" : "password")"
                           @bind="password"
                           placeholder="Tu contraseña"
                           class="@(errores.ContainsKey("Password") ? "err" : "")" />
                    <i class="fa-solid @(mostrarPassword ? "fa-eye-slash" : "fa-eye") pwd-toggle"
                       @onclick="() => mostrarPassword = !mostrarPassword"></i>
                </div>
                @if (errores.ContainsKey("Password"))
                {
                    <span class="field-error">
                        <i class="fa-solid fa-circle-exclamation"></i> @errores["Password"]
                    </span>
                }
            </div>

            <!-- Forgot -->
            <div class="forgot-row">
                <a href="/recuperar" class="forgot-link">
                    <i class="fa-solid fa-key"></i> ¿Olvidaste tu contraseña?
                </a>
            </div>

            <!-- Submit -->
            <button class="btn-submit" @onclick="IniciarSesion" disabled="@(cargando || cuentaBloqueada)">
                @if (cargando)
                {
                    <i class="fa-solid fa-spinner fa-spin"></i>
                    <span>Verificando...</span>
                }
                else if (cuentaBloqueada)
                {
                    <i class="fa-solid fa-lock"></i>
                    <span>Cuenta Bloqueada</span>
                }
                else
                {
                    <i class="fa-solid fa-right-to-bracket"></i>
                    <span>Iniciar Sesión</span>
                }
            </button>

            <div class="divider">o</div>

            <div class="login-footer">
                ¿No tienes cuenta?
                <a href="/register">Regístrate aquí</a>
            </div>
        </div>
    </div>
</div>
@code {
    [Inject] private IDbContextFactory<AppDbContext> DbFactory { get; set; } = default!;

    private string email = "";
    private string password = "";
    private bool mostrarPassword = false;
    private bool cargando = false;
    private bool cuentaBloqueada = false;
    private int intentosFallidos = 0;

    private Usuario? usuarioEncontrado = null;
    private Dictionary<string, string> errores = new();

    // Debounce para no consultar en cada tecla
    private CancellationTokenSource? _cts;

    private async Task OnEmailInput(ChangeEventArgs e)
    {
        email = e.Value?.ToString() ?? "";
        usuarioEncontrado = null;
        cuentaBloqueada = false;

        // Cancelar la búsqueda anterior si el usuario sigue escribiendo
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;

        // Esperar 400ms antes de consultar (debounce)
        try { await Task.Delay(400, token); }
        catch (TaskCanceledException) { return; }

        if (!email.Contains('@') || !email.Contains('.')) return;

        try
        {
            // Crear contexto nuevo e independiente para esta consulta
            await using var ctx = await DbFactory.CreateDbContextAsync(token);
            usuarioEncontrado = await ctx.Usuarios
                .FirstOrDefaultAsync(u => u.Email == email, token);

            if (usuarioEncontrado != null)
            {
                cuentaBloqueada = usuarioEncontrado.CuentaBloqueada == true;
                intentosFallidos = usuarioEncontrado.IntentosFallidos ?? 0;
            }
        }
        catch (OperationCanceledException) { /* búsqueda cancelada, ignorar */ }
        catch { /* error de conexión, ignorar silenciosamente */ }
    }

    private async Task IniciarSesion()
    {
        errores.Clear();

        if (string.IsNullOrWhiteSpace(email))
            errores["Email"] = "Ingresa tu correo.";
        else if (!email.Contains('@'))
            errores["Email"] = "Formato de correo inválido.";

        if (string.IsNullOrWhiteSpace(password))
            errores["Password"] = "Ingresa tu contraseña.";

        if (errores.Count > 0)
        {
            await Swal("warning", "Campos incompletos",
                "Por favor completa todos los campos antes de continuar.");
            return;
        }

        cargando = true;

        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var usuario = await ctx.Usuarios
                .FirstOrDefaultAsync(u => u.Email == email);

            if (usuario == null)
            {
                errores["Email"] = "Correo no registrado.";
                await Swal("error", "Usuario no encontrado",
                    "No existe una cuenta con ese correo electrónico.");
                return;
            }

            if (usuario.CuentaBloqueada == true)
            {
                await Swal("error", "Cuenta Bloqueada",
                    "Tu cuenta ha sido bloqueada por múltiples intentos fallidos. Contacta al administrador.");
                return;
            }

            // Comparar hash SHA-256
            using var sha = SHA256.Create();
            var hashIngresado = Convert.ToHexString(
                sha.ComputeHash(Encoding.UTF8.GetBytes(password))
            ).ToLower();

            if (hashIngresado != usuario.PasswordHash)
            {
                usuario.IntentosFallidos = (usuario.IntentosFallidos ?? 0) + 1;
                intentosFallidos = usuario.IntentosFallidos.Value;

                if (usuario.IntentosFallidos >= 3)
                {
                    usuario.CuentaBloqueada = true;
                    usuario.FechaDesbloqueo = DateTime.Now.AddHours(24);
                    cuentaBloqueada = true;
                    await ctx.SaveChangesAsync();
                    await Swal("error", "Cuenta Bloqueada",
                        "Has superado el límite de 3 intentos. Tu cuenta ha sido bloqueada por 24 horas.");
                    return;
                }

                await ctx.SaveChangesAsync();
                int restantes = 3 - usuario.IntentosFallidos.Value;
                errores["Password"] = "Contraseña incorrecta.";
                await Swal("warning", "Contraseña Incorrecta",
                    $"La contraseña no es válida. Te quedan {restantes} intento(s) antes del bloqueo.");
                return;
            }

            // ✅ Éxito
            usuario.IntentosFallidos = 0;
            usuario.CuentaBloqueada = false;
            usuario.UltimoAcceso = DateTime.Now;
            await ctx.SaveChangesAsync();

            await JS.InvokeVoidAsync("Swal.fire", new
            {
                icon = "success",
                title = $"¡Bienvenido/a, {usuario.Nombres?.Split(' ').FirstOrDefault()}!",
                html = "<p>Acceso concedido correctamente.</p>",
                confirmButtonText = "Entrar al sistema",
                confirmButtonColor = "#5b399c",
                timer = 3000,
                timerProgressBar = true
            });

            Nav.NavigateTo("/dashboard");
        }
        catch (Exception ex)
        {
            await Swal("error", "Error del sistema",
                "Ocurrió un problema al conectar: " + ex.Message);
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task Swal(string icon, string title, string text)
    {
        try
        {
            await JS.InvokeVoidAsync("Swal.fire", new
            {
                icon,
                title,
                text,
                confirmButtonColor = "#5b399c"
            });
        }
        catch { }
    }
}
